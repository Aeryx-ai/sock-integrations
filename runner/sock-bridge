#!/bin/sh
# sock-bridge: the command `sock listen --exec` runs once per message, to carry the
# owner's reply into one Claude Managed Agents session as a user.message and the
# agent's answer back to the owner with `sock send`
# (docs/specs/integrations.md, "Managed Agents bridge: sock-bridge").
#
# Exit 0 acknowledges the message (answered, or dropped as not the owner's or
# malformed). Exit 1 leaves it pending for a retry. Exit 2 is a bad configuration
# or a refused key: nothing was sent and the message stays pending.
#
# Needs curl and jq. The owner's text goes only into the request body; the API key
# only into a private curl config file, never argv, an environment or a log.
# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC2034,SC2154 # the settings lib.sh reads, and what it sets
set -u
umask 077
# the key leaves the environment before any child runs: from here on it is a
# shell variable only (unset first: one inherited from the environment would
# stay exported), and goes nowhere but the curl config
unset key
key=${ANTHROPIC_API_KEY:-}
unset ANTHROPIC_API_KEY

cmd_name=sock-bridge
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=lib.sh
. "$here/lib.sh"

# --- configuration -----------------------------------------------------------
session=${SOCK_BRIDGE_SESSION:-}
api=${SOCK_BRIDGE_API:-https://api.anthropic.com}
# the key goes to this URL: https, or http to a loopback address (the tests)
printf '%s\n' "$api" | grep -Eqx 'https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?|http://(localhost|127\.0\.0\.1)(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?' ||
	die_config "SOCK_BRIDGE_API must be an https URL, or http to localhost or 127.0.0.1"
# every curl gets -q first, so no curlrc is read (a `location` there would follow
# a redirect with the key, a `trace-ascii` would write it down), and speaks only
# the API's scheme, following no redirect
case $api in
http://*) proto='=http,https' ;;
*) proto='=https' ;;
esac
# session_ok: a session id, as SOCK_BRIDGE_SESSION or a create answer gives it
session_ok() { matches "$1" '[A-Za-z0-9_][A-Za-z0-9_-]{0,127}'; }
# A session per conversation, created from an agent and an environment, or the
# one session SOCK_BRIDGE_SESSION names: never both
agent=${SOCK_BRIDGE_AGENT:-}
environment=${SOCK_BRIDGE_ENVIRONMENT:-}
agent_version=${SOCK_BRIDGE_AGENT_VERSION:-}
budget=${SOCK_BRIDGE_BUDGET:-}
if [ -n "$agent" ]; then
	[ -z "$session" ] || die_config "set SOCK_BRIDGE_AGENT or SOCK_BRIDGE_SESSION, not both"
	matches "$agent" 'agent_[A-Za-z0-9]{1,120}' || die_config "SOCK_BRIDGE_AGENT must be an agent id, agent_ and 1 to 120 of A-Z a-z 0-9"
	matches "$environment" 'env_[A-Za-z0-9]{1,120}' ||
		die_config "SOCK_BRIDGE_ENVIRONMENT must be an environment id, env_ and 1 to 120 of A-Z a-z 0-9"
	[ -z "$agent_version" ] || matches "$agent_version" '[1-9][0-9]{0,8}' ||
		die_config "SOCK_BRIDGE_AGENT_VERSION must be a positive integer of at most 9 digits"
	[ -z "$budget" ] || matches "$budget" '[1-9][0-9]{0,8}' ||
		die_config "SOCK_BRIDGE_BUDGET must be whole US cents, at most 9 digits, no leading zero"
	need_puppet_id=1
else
	[ -z "$environment$agent_version$budget" ] ||
		die_config "SOCK_BRIDGE_ENVIRONMENT, SOCK_BRIDGE_AGENT_VERSION and SOCK_BRIDGE_BUDGET need SOCK_BRIDGE_AGENT"
	session_ok "$session" ||
		die_config "SOCK_BRIDGE_SESSION must be 1 to 128 characters of A-Z a-z 0-9 _ -, not starting with -; or set SOCK_BRIDGE_AGENT"
fi
printf '%s\n' "$key" | grep -Eqx '[A-Za-z0-9_.-]{8,200}' || die_config "ANTHROPIC_API_KEY is missing or has characters an API key does not"
for tool in curl jq sock; do
	command -v "$tool" >/dev/null 2>&1 || die_config "$tool is not on PATH"
done
timeout=${SOCK_BRIDGE_TIMEOUT:-900}
case $timeout in
'' | *[!0-9]*) timeout=900 ;;
esac
[ "$timeout" -gt 0 ] || timeout=900
# the most the stream file may hold: a flood stops the turn instead of the disk
max_stream=${SOCK_BRIDGE_MAX_STREAM:-33554432}
case $max_stream in
'' | *[!0-9]*) max_stream=33554432 ;;
esac

state_dir=${SOCK_BRIDGE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/sock-integrations-bridge}
log_name=bridge.log
lock_name=bridge.lock
ledger_name=done.ids
lib_init
sent_file=$state_dir/sent.ids

# --- temp files, named <prefix>.<pid> so a SIGKILLed run's are swept by the next
# (lib.sh sweep_dead), and the stream: removed on exit --------------------------
cfg=$state_dir/curl.$$
codef=$state_dir/code.$$
hdr=$state_dir/hdr.$$
resp=$state_dir/resp.$$
stream_file=$state_dir/stream.$$
stream_hdr=$state_dir/streamh.$$
body=$state_dir/body.$$
turn=$state_dir/turn.$$
turnn=$state_dir/turnn.$$
new=$state_dir/new.$$
newc=$state_dir/newc.$$
batch=$state_dir/batch.$$
page=$state_dir/page.$$
hist=$state_dir/hist.$$
histp=$state_dir/histp.$$
parts=$state_dir/parts.$$
reasonf=$state_dir/reason.$$
cfnew=$state_dir/cfnew.$$
cfadd=$state_dir/cfadd.$$
cfall=$state_dir/cfall.$$
stream_pid=
curl_pid=
# shellcheck disable=SC2329 # run by the library's EXIT trap
extra_cleanup() {
	[ -n "$stream_pid" ] && kill "$stream_pid" 2>/dev/null
	[ -n "$curl_pid" ] && kill "$curl_pid" 2>/dev/null
	rm -rf "$cfg" "$codef" "$hdr" "$resp" "$stream_file" "$stream_hdr" "$body" "$turn" "$turnn" "$new" "$newc" "$batch" "$page" "$hist" "$histp" "$parts" "$reasonf" "$cfnew" "$cfadd" "$cfall"
}
install_traps

read_message
owner_gate
drop_if_done
take_lock
drop_if_done

deadline=$(($(now) + timeout))

# the key goes to curl in a private config, so it is in no argv or environment
{
	printf 'header = "x-api-key: %s"\n' "$key"
	printf '%s\n' 'header = "anthropic-version: 2023-06-01"' 'header = "anthropic-beta: managed-agents-2026-04-01"' \
		'header = "content-type: application/json"' 'user-agent = "sock-bridge"'
} >"$cfg" || exit 1
unset key

sessions_file=$state_dir/sessions
creating=
pass=

# retry_wait [header file]: sleeps the Retry-After of that response (seconds, or
# an HTTP date, which is GMT), else 1, 2, 4 s; never past the time left
retry_wait() {
	ra=$(sed -n 's/^[Rr]etry-[Aa]fter: *//p' "${1:-$hdr}" | tr -d '\r' | sed 's/ *$//' | head -n 1)
	wait=$((1 << attempt))
	case $ra in
	'') ;;
	*[!0-9]*)
		when=$(LC_ALL=C TZ=UTC date -j -f '%a, %d %b %Y %H:%M:%S GMT' "$ra" +%s 2>/dev/null ||
			LC_ALL=C date -u -d "$ra" +%s 2>/dev/null || echo "")
		case $when in
		'' | *[!0-9]*) ;;
		*) wait=$((when - $(now))) ;;
		esac
		;;
	*)
		# a number too long for the arithmetic is past any time left
		digits=$(printf '%s' "$ra" | sed 's/^0*//')
		case ${#digits} in
		0) wait=0 ;;
		[1-6]) wait=$digits ;;
		*) wait=$((deadline - $(now))) ;;
		esac
		;;
	esac
	[ "$wait" -lt 0 ] && wait=0
	left=$((deadline - $(now)))
	[ "$wait" -gt "$left" ] && wait=$left
	[ "$wait" -gt 0 ] && nap "$wait"
	return 0
}

# retry_or_exit METHOD CODE [header file]: after a request that failed, exits
# (2 when the key or session is refused, 1 when the failure is not retried or the
# tries are used up) or waits as retry_wait does and returns, to try again. 429
# is retried for any request, and 5xx and network failures (000) too for a GET; a
# POST that failed any other way may have landed, so it is not repeated (the
# redelivery asks the session's history before it sends again).
retry_or_exit() {
	case $2 in
	400 | 404)
		# a create refused: the agent or environment is wrong or archived
		if [ -n "$creating" ]; then
			log_line "http $2"
			echo "$cmd_name: the Managed Agents API refused to create a session ($2): check SOCK_BRIDGE_AGENT and SOCK_BRIDGE_ENVIRONMENT" >&2
			exit 2
		fi
		# a session of the bridge's own that went away since its check: the
		# retry checks again and replaces it
		if [ "$2" = 400 ] || [ -n "$agent" ]; then
			log_line "http $2"
			exit 1
		fi
		log_line "http $2"
		echo "$cmd_name: the Managed Agents API answered $2: check ANTHROPIC_API_KEY and SOCK_BRIDGE_SESSION" >&2
		exit 2
		;;
	401 | 403)
		log_line "http $2"
		echo "$cmd_name: the Managed Agents API answered $2: check ANTHROPIC_API_KEY" >&2
		exit 2
		;;
	429) ;;
	5?? | 000) [ "$1" = GET ] || {
		log_line "http $2"
		exit 1
	} ;;
	*)
		log_line "http $2"
		exit 1
		;;
	esac
	attempt=$((attempt + 1))
	if [ "$attempt" -ge 4 ]; then
		log_line "http $2"
		exit 1
	fi
	retry_wait "${3:-$hdr}"
}

# api METHOD URL [body file]: sets code and leaves the answer in $resp, retrying
# as retry_or_exit says
api() {
	method=$1
	url=$2
	data=${3:-}
	attempt=0
	while :; do
		left=$((deadline - $(now)))
		if [ "$left" -le 0 ]; then
			log_line "timeout"
			exit 1
		fi
		set -- -q -sS --proto "$proto" --proto-redir "$proto" --max-redirs 0 --config "$cfg" -X "$method" -o "$resp" -D "$hdr" -w '%{http_code}' --connect-timeout 10 --max-time "$left"
		[ -n "$data" ] && set -- "$@" --data-binary "@$data"
		# a job waited on, as nap is, so a TERM need not wait out the request
		curl "$@" "$url" >"$codef" 2>/dev/null &
		curl_pid=$!
		if wait "$curl_pid"; then code=$(cat "$codef"); else code=000; fi
		curl_pid=
		case $code in
		2??) return 0 ;;
		esac
		# a caller that asks for it hears of that status instead: a 404 (a gone
		# session) or a 400 (a confirmation no longer pending)
		if [ -n "$pass" ] && [ "$code" = "$pass" ]; then return 1; fi
		retry_or_exit "$method" "$code"
	done
}

# --- posting to the owner: fixed texts or the agent's text, split, bounded ---
# utf8_cut.awk: cuts a line at most max bytes long, never inside a character
awk_cut='
	function ord_init(   i) { for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i }
	function cut_at(line, max,   n) {
		n = max
		while (n > 0 && (ord[substr(line, n + 1, 1)] >= 128 && ord[substr(line, n + 1, 1)] < 192)) n--
		return n
	}'
# the text goes on stdin: argv is visible in ps to the same user
post_one() { printf '%s' "$1" | sock send >/dev/null 2>&1; }
# clean_text removes the control characters but newline and tab: C0 (CR among
# them), DEL, and C1 (U+0080 to U+009F, the UTF-8 pairs C2 80 to C2 9F: C2 only
# ever leads a character, so no other one is cut), and the characters that can
# reorder or break what the owner's client shows: U+2028 to U+202E (line and
# paragraph separators, bidi embeddings and overrides, E2 80 A8 to AE) and
# U+2066 to U+2069 (bidi isolates, E2 81 A6 to A9)
c1=$(printf '\302[\200-\237]')
bidi=$(printf '\342\200[\250-\256]')
isol=$(printf '\342\201[\246-\251]')
clean_text() { LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C sed "s/$c1//g; s/$bidi//g; s/$isol//g"; }
# post_text TEXT [FIRST]
post_text() {
	mkdir -p "$parts" || exit 1
	# Paragraphs (lines up to a blank one) go into a part whole; one too long for
	# a part is packed by lines, and a line too long for one is cut by bytes.
	printf '%s\n' "$1" | LC_ALL=C awk -v max=60000 -v dir="$parts" "$awk_cut"'
		function put(line,   c) {
			while (length(line) + 1 > max) {
				if (size > 0) { n++; size = 0 }
				c = cut_at(line, max - 1)
				print substr(line, 1, c) > (dir "/part." n); close(dir "/part." n)
				line = substr(line, c + 1)
				n++; size = 0
			}
			if (size + length(line) + 1 > max && size > 0) { n++; size = 0 }
			print line >> (dir "/part." n); size += length(line) + 1
			close(dir "/part." n)
		}
		function flush(   i) {
			if (size > 0 && size + psize > max && psize <= max) { n++; size = 0 }
			for (i = 1; i <= pn; i++) put(para[i])
			pn = 0; psize = 0
		}
		BEGIN { ord_init(); n = 1; size = 0; pn = 0; psize = 0 }
		{ para[++pn] = $0; psize += length($0) + 1 }
		/^[ \t]*$/ { flush() }
		END { flush() }'
	count=$(find "$parts" -name 'part.*' | wc -l | tr -d ' ')
	[ "$count" -gt 0 ] || { printf '%s\n' "$1" >"$parts/part.1"; count=1; }
	# a first message of its own goes ahead of the parts, counted with them
	if [ -n "${2:-}" ]; then
		i=$count
		while [ "$i" -gt 0 ]; do
			mv "$parts/part.$i" "$parts/part.$((i + 1))" || exit 1
			i=$((i - 1))
		done
		printf '%s\n' "$2" >"$parts/part.1" || exit 1
		count=$((count + 1))
	fi
	# parts of this message already posted by an earlier run stay posted
	i=1
	posted_file=$state_dir/posted.part
	if [ -f "$posted_file" ] && [ "$(cut -d' ' -f1 "$posted_file")" = "$stdin_id" ]; then
		n=$(cut -d' ' -f2 "$posted_file")
		case $n in
		'' | *[!0-9]*) n=0 ;;
		esac
		i=$((n + 1))
	fi
	while [ "$i" -le "$count" ] && [ "$i" -le 5 ]; do
		part=$(cat "$parts/part.$i")
		if [ "$i" -eq 5 ] && [ "$count" -gt 5 ]; then
			part="$(printf '%s' "$part" | LC_ALL=C awk -v max=59000 "$awk_cut"'
				BEGIN { ord_init() } { buf = buf (NR > 1 ? "\n" : "") $0 } END { print substr(buf, 1, cut_at(buf, max)) }')
[cut: the rest of the answer was not sent]"
		fi
		post_one "$part" || {
			log_line "send failed"
			exit 1
		}
		printf '%s %s\n' "$stdin_id" "$i" >"$posted_file" 2>/dev/null || true
		i=$((i + 1))
	done
	rm -rf "$parts"
}

# answer posts a text to the owner (after FIRST, as its own message, when
# given), records the message replied, logs the outcome and acknowledges
answer() {
	post_text "$1" "${3:-}"
	record_done
	log_line "$2"
	exit 0
}

# finish posts the outcome of a turn and acknowledges: reason is the stop reason
# (or "error"), text the agent's answer. A turn waiting on tool calls asks the
# owner (ask); any other end means the session waits on none of its calls.
finish() {
	reason=$1
	text=$(printf '%s' "$2" | clean_text)
	[ "$reason" = requires_action ] && ask "$text"
	confirm_drop_session
	case $reason in
	end_turn)
		[ -n "$(printf '%s' "$text" | tr -d ' \t\r\n')" ] || text="the agent finished without a reply"
		out="ran"
		;;
	budget_reached)
		text="the agent's budget is used up"
		out="budget"
		;;
	*)
		text="the agent hit an error"
		# name what the API said, if it looks like a stop reason
		# as a whole string: grep -x would pass one line of a value with a newline
		case $reason in
		'' | *[!abcdefghijklmnopqrstuvwxyz_]*) why=unknown ;;
		*) if [ "${#reason}" -le 40 ]; then why=$reason; else why=unknown; fi ;;
		esac
		out="agent error ($why)"
		;;
	esac
	answer "$text" "$out"
}

# mark_sent records the id in sent.ids BEFORE the user.message is posted: a run
# killed or failed between the post and the record would otherwise send it again
mark_sent() {
	{
		printf '%s\n' "$stdin_id" >>"$sent_file" &&
			tail -n 200 "$sent_file" >"$sent_file.tmp" && mv "$sent_file.tmp" "$sent_file"
	} 2>/dev/null
}

# turn_jq is the one reading of a turn's events, for the stream and the history
# alike. step($e; $tag; $tuid) folds an event into the state {started, ids,
# texts, tools, reason, blockers}. The turn starts at its anchor: a
# user.message whose second line is this message's tag, or, when $tuid is set,
# the user.tool_confirmation of that call; the last one counts. Before it, and
# after the turn's end, nothing counts. agent.message text is kept in order,
# once per id. An event whose id is not a string of 1 to 256 characters without
# a control character (a number, one holding a newline) is refused; one with no
# id is kept. Of a tool call only its type, name, server and evaluated
# permission are kept, by id, never its input. The end is the first
# session.status_idle, with its stop reason (end_turn when it gives none) and
# the ids it waits on, each once, or session.error. An end seen before the turn started
# sets unanchored: on the stream, that is an end the bridge cannot place.
# shellcheck disable=SC2016 # jq's variables, not the shell's
turn_jq='
def texts: [.content[]? | objects | select(.type == "text") | .text | strings];
def okid: if .id == null then "" elif (.id | type) == "string" and (.id | test("^[^\u0000-\u001f\u007f]{1,256}$")) then .id else null end;
def str: if type == "string" then . else null end;
def anchor($tag; $tuid):
	if $tuid != "" then .type == "user.tool_confirmation" and .tool_use_id == $tuid
	else .type == "user.message" and ((texts | join("") | split("\n"))[1] == $tag) end;
def tooluse: .type == "agent.tool_use" or .type == "agent.mcp_tool_use" or .type == "agent.custom_tool_use";
def step($e; $tag; $tuid):
	if ($e | anchor($tag; $tuid)) then {started: true, ids: {}, texts: [], tools: {}, reason: null}
	elif (.started | not) then (if $e.type == "session.status_idle" or $e.type == "session.error" then .unanchored = true else . end)
	elif .reason != null then .
	elif $e.type == "agent.message" then
		($e | okid) as $k
		| if $k == null or ($k != "" and .ids[$k]) then .
		  else .texts += [$e | texts | join("")] | if $k != "" then .ids[$k] = true else . end end
	elif ($e | tooluse) then
		($e | okid) as $k
		| if $k == null or $k == "" then .
		  else .tools[$k] = {type: $e.type, name: ($e.name | str), server: ($e.mcp_server_name | str), perm: ($e.evaluated_permission | str)} end
	elif $e.type == "session.status_idle" then
		.reason = ((($e.stop_reason | objects | .type) // "end_turn") | tostring)
		| .blockers = ([$e.stop_reason | objects | .event_ids | arrays | .[] | strings]
			| reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end))
	elif $e.type == "session.error" then .reason = "error"
	else . end;
'
# tuid is the call a confirmation answers: set, a turn starts at its
# user.tool_confirmation instead of this message's user.message
tuid=
tag=$(open_tag | tr -d '\n')

# fetch_history leaves every event of the session in $hist as {data: [...]},
# following next_page (events are in processed_at order, oldest first)
fetch_history() {
	: >"$histp"
	api GET "$base?beta=true"
	cp "$resp" "$page"
	n=0
	while :; do
		jq -c '.data // []' "$page" >>"$histp" 2>/dev/null || {
			log_line "http bad history"
			exit 1
		}
		next=$(jq -r '.next_page // empty' "$page" 2>/dev/null)
		[ -n "$next" ] || break
		n=$((n + 1))
		if [ "$n" -ge 200 ]; then
			log_line "history too long"
			exit 1
		fi
		api GET "$base?beta=true&page=$(jq -rn --arg v "$next" '$v | @uri')"
		cp "$resp" "$page"
	done
	jq -cs '{data: (add // [])}' "$histp" >"$hist"
	rm -f "$histp"
}

# catch_up reads the history for this message's turn into $turn. It sets found
# and finished, and verdict, which holds reason and text.
catch_up() {
	fetch_history
	jq -c --arg tag "$tag" --arg tuid "$tuid" "$turn_jq"'
		reduce (.data[]? | objects) as $e ({started: false}; step($e; $tag; $tuid))' "$hist" >"$turn" 2>/dev/null ||
		printf '%s\n' '{"started": false}' >"$turn"
	verdict=$(jq -c '{found: (.started == true), done: (.reason != null), reason, text: ((.texts // []) | join("\n\n"))}' "$turn" 2>/dev/null) ||
		verdict='{"found":false}'
	found=$(printf '%s' "$verdict" | jq -r '.found // false')
	finished=$(printf '%s' "$verdict" | jq -r '.done // false')
}

# from_history polls the history until this message's turn is done, then
# finishes. When the message is not there: "send" returns, so the caller sends
# it; "wait" keeps polling (it was posted, and the history may lag).
from_history() {
	while :; do
		catch_up
		if [ "$found" = true ] && [ "$finished" = true ]; then
			finish "$(printf '%s' "$verdict" | jq -r '.reason // "error"')" "$(printf '%s' "$verdict" | jq -r '.text // ""')"
		fi
		[ "$found" = true ] || [ "$1" = wait ] || return 0
		if [ "$(now)" -ge "$deadline" ]; then
			log_line "timeout"
			exit 1
		fi
		nap 2
	done
}

# --- the session: SOCK_BRIDGE_SESSION, or this conversation's own -----------
# map_put SESSION rewrites the map with this conversation's line set to SESSION,
# or dropped when it is empty: under the run lock, by tmp and rename, mode 600
map_put() {
	# the other conversations' lines first: a map awk cannot read fails closed
	# here, before a rename could replace it with this conversation's line alone
	if [ -f "$sessions_file" ]; then
		awk -v c="$stdin_conv" '$1 != c' "$sessions_file" >"$sessions_file.tmp" 2>/dev/null || {
			rm -f "$sessions_file.tmp"
			log_line "sessions not readable"
			exit 1
		}
	else
		: >"$sessions_file.tmp" 2>/dev/null
	fi
	{
		if [ -n "$1" ]; then printf '%s %s\n' "$stdin_conv" "$1" >>"$sessions_file.tmp"; fi &&
			chmod 600 "$sessions_file.tmp" && mv "$sessions_file.tmp" "$sessions_file"
	} 2>/dev/null || {
		log_line "sessions not writable"
		exit 1
	}
}

# fits_jq: fits is true for a session made for this configuration: the agent,
# the environment and the version when it is set, exactly, and, when a budget
# is set, a USD budget of at most that many cents. Within the cap keeps a
# session the operator's raised budget covers, and one the owner resumed in the
# console within it; above it, or no budget at all, does not fit. Check and
# Find both ask it, so a configuration change never keeps an old session.
# shellcheck disable=SC2016 # jq's variables
fits_jq='def fits($a; $e; $v; $b):
	((.agent | objects | .id) == $a) and .environment_id == $e
	and ($v == "" or ((.agent | objects | .version | numbers | tostring) == $v))
	and ($b == "" or ([.budget | objects | .max_list_cost | objects | select(.currency == "USD")
		| .amount | strings | select(test("\\A[1-9][0-9]{0,11}\\z")) | tonumber <= ($b | tonumber)] == [true]));'

# find_session sets session to the newest live session of the agent made for
# this conversation by this puppet, or empty. The list has no metadata filter:
# the match is here, bounded at 10 pages, past which the bridge creates.
find_session() {
	session=
	url="$api/v1/sessions?beta=true&agent_id=$agent&order=desc&limit=100"
	n=0
	while :; do
		api GET "$url"
		# shellcheck disable=SC2016 # jq's variables
		session=$(jq -r --arg c "$stdin_conv" --arg p "$puppet_id" --arg g "$gone" \
			--arg a "$agent" --arg e "$environment" --arg v "$agent_version" --arg b "$budget" "$fits_jq"'
			[.data[]? | select(type == "object" and (.metadata | type) == "object"
				and .metadata.bridge_conversation == $c and .metadata.bridge_puppet == $p
				and fits($a; $e; $v; $b)
				and .archived_at == null and .status != "terminated"
				and (.id | type) == "string" and .id != $g
				and (.id | test("\\A[A-Za-z0-9_][A-Za-z0-9_-]{0,127}\\z")))
			| .id] | first // empty' "$resp" 2>/dev/null)
		if [ -n "$session" ]; then
			session_ok "$session" && return 0
			session=
		fi
		next=$(jq -r '.next_page | strings' "$resp" 2>/dev/null)
		n=$((n + 1))
		[ -n "$next" ] && [ "$n" -lt 10 ] || return 0
		url="$api/v1/sessions?beta=true&agent_id=$agent&order=desc&limit=100&page=$(jq -rn --arg v "$next" '$v | @uri')"
	done
}

# create_session makes this conversation's session and records it. The API
# takes no idempotency key: a create that may have landed exits 1 and is
# never repeated here; the retry finds it.
create_session() {
	# shellcheck disable=SC2016 # jq's variables
	jq -n --arg a "$agent" --arg v "$agent_version" --arg e "$environment" --arg c "$stdin_conv" \
		--arg p "$puppet_id" --arg b "$budget" '
		{agent: (if $v == "" then $a else {type: "agent", id: $a, version: ($v | tonumber)} end),
		 environment_id: $e,
		 title: ("sock " + $c[0:8]),
		 metadata: {bridge_conversation: $c, bridge_puppet: $p}}
		+ (if $b == "" then {} else {budget: {type: "limit", max_list_cost: {amount: $b, currency: "USD"}}} end)' >"$body" || exit 1
	creating=1
	api POST "$api/v1/sessions?beta=true" "$body"
	creating=
	session=$(jq -r '.id | strings' "$resp" 2>/dev/null)
	# a session the bridge cannot use, and Find will not adopt: exit 2, since a
	# retry would only create another one
	if ! session_ok "$session"; then
		log_line "session id invalid"
		echo "$cmd_name: the Managed Agents API answered a create with a session id the bridge refuses" >&2
		exit 2
	fi
	map_put "$session"
}

# resolve_session sets session to this conversation's: the mapped one while it
# lives and fits the configuration, else one Find adopts, else a new one. A
# mapped session that is gone (404, terminated or archived), or was made for
# another configuration, is replaced and the owner is told.
resolve_session() {
	gone=
	notice=
	if [ -e "$sessions_file" ] && [ ! -r "$sessions_file" ]; then
		log_line "sessions not readable"
		exit 1
	fi
	session=$(awk -v c="$stdin_conv" '$1 == c { print $2; exit }' "$sessions_file" 2>/dev/null)
	if [ -n "$session" ] && session_ok "$session"; then
		pass=404
		if api GET "$api/v1/sessions/$session?beta=true"; then
			if jq -e '.status == "terminated" or .archived_at != null' "$resp" >/dev/null 2>&1; then
				gone=$session
				notice="the agent's earlier session ended; this reply started a new one"
				outcome="session gone"
			elif ! jq -e --arg a "$agent" --arg e "$environment" --arg v "$agent_version" --arg b "$budget" \
				"$fits_jq"'fits($a; $e; $v; $b)' "$resp" >/dev/null 2>&1; then
				gone=$session
				notice="the bridge configuration changed; this reply started a new session"
				outcome="session config changed"
			fi
		else
			gone=$session
			notice="the agent's earlier session ended; this reply started a new one"
			outcome="session gone"
		fi
		pass=
		[ -n "$gone" ] || return 0
		map_put ""
		log_line "$outcome"
	fi
	find_session
	if [ -n "$session" ]; then
		map_put "$session"
		log_line "session adopted"
	else
		create_session
		log_line "session created"
	fi
	if [ -n "$notice" ]; then
		post_one "$notice" || {
			log_line "send failed"
			exit 1
		}
	fi
}


# --- tool confirmations brokered through the owner ---------------------------
# confirm.pending holds one line per call waiting on the owner:
#   <code> <conversationId> <session> <tool_use_id> <pending|sent> <message id|-> <tool|?> <server|?>
# The code is 6 characters of a-km-z2-9 from /dev/urandom. It goes only into
# this file and to the owner: never into the session, a request, the log or
# any process's argv (a child gets it in its environment, BRIDGE_CODE or
# BRIDGE_CODES, which only this user can read). The file is read and
# rewritten only under the run lock, by tmp and rename, mode 600, and holds at
# most 50 lines (ask keeps the bound).
confirm_file=$state_dir/confirm.pending

# confirm_put FILE replaces confirm.pending with FILE
confirm_put() {
	{
		cat "$1" >"$confirm_file.tmp" && chmod 600 "$confirm_file.tmp" && mv "$confirm_file.tmp" "$confirm_file"
	} 2>/dev/null || {
		log_line "confirm not writable"
		exit 1
	}
}

# confirm_keep AWK rewrites confirm.pending with only the lines AWK prints;
# s is the session, c the code ($ccode), v the conversation and m the message.
# Every match is made on text ("" $1 == "" c): awk compares two strings that
# read as numbers as numbers, and 10 and 1e1 are one number
confirm_keep() {
	[ -f "$confirm_file" ] || return 0
	BRIDGE_CODE=${ccode:-} awk -v s="$session" -v v="$stdin_conv" -v m="$stdin_id" 'BEGIN { c = ENVIRON["BRIDGE_CODE"] } '"$1" "$confirm_file" >"$cfnew" 2>/dev/null || {
		log_line "confirm not writable"
		exit 1
	}
	confirm_put "$cfnew"
}
# the session waits on none of its calls any more
confirm_drop_session() {
	[ -f "$confirm_file" ] && awk -v s="$session" '"" $3 == "" s { f = 1 } END { exit !f }' "$confirm_file" 2>/dev/null || return 0
	# shellcheck disable=SC2016 # awk's fields
	confirm_keep '"" $3 != "" s'
}
# shellcheck disable=SC2016 # awk's fields
confirm_drop_line() { confirm_keep '!("" $1 == "" c && "" $2 == "" v)'; }

# new_code sets ccode to a fresh one, unique among the codes in confirm.pending
# and $cfadd
new_code() {
	for _ in 1 2 3 4 5 6 7 8; do
		ccode=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc 'a-km-z2-9' | head -c 6)
		[ "${#ccode}" -eq 6 ] || continue
		cat "$confirm_file" "$cfadd" 2>/dev/null |
			BRIDGE_CODE=$ccode awk 'BEGIN { c = ENVIRON["BRIDGE_CODE"] } "" $1 == "" c { f = 1 } END { exit !f }' || return 0
	done
	log_line "no code"
	exit 1
}

# pending_codes prints every code in confirm.pending, one per line
pending_codes() { cut -d' ' -f1 "$confirm_file" 2>/dev/null; }
# scrub_jq defines scrub: every code of $ENV.BRIDGE_CODES replaced by [code],
# in any case, with format characters (Cf) allowed between its characters
# shellcheck disable=SC2016 # jq's variables
scrub_jq='def scrub: reduce ($ENV.BRIDGE_CODES // "" | split("\n")[] | select(test("\\A[a-km-z2-9]{6}\\z"))) as $c
	(.; gsub($c | split("") | join("\\p{Cf}*"); "[code]"; "i"));'

# requests prints, for each line of this conversation and session still
# pending, what the owner replies to answer it
requests() {
	awk -v s="$session" -v v="$stdin_conv" '"" $2 == "" v && "" $3 == "" s && $5 == "pending" {
		tool = ($7 == "?") ? "a tool" : $7
		if ($8 != "?") tool = tool " from " $8
		if (n++) printf "\n\n"
		printf "the agent wants to run %s: reply \"approve %s\" or \"deny %s <optional reason>\"", tool, $1, $1
	}' "$confirm_file" 2>/dev/null
}

# blockers_jq lists the calls a requires_action turn waits on, one per line:
# <id> <ask|custom|unseen|other> <tool|?> <server|?>, or "! bad ? ?" for an id
# that cannot be a tool_use_id. A name outside [A-Za-z0-9_.-]{1,64} is "?".
# shellcheck disable=SC2016 # jq's variables
blockers_jq='
def ok: if type == "string" and test("\\A[A-Za-z0-9_.-]{1,64}\\z") then . else "?" end;
(.tools // {}) as $t
| (.blockers // [])[]
| if test("\\A[A-Za-z0-9_-]{1,128}\\z") | not then "! bad ? ?"
  else . as $id | $t[$id] as $u
  | [$id,
     (if $u == null then "unseen" elif $u.type == "agent.custom_tool_use" then "custom" elif $u.perm == "ask" then "ask" else "other" end),
     ($u.name | ok),
     (if $u.type == "agent.mcp_tool_use" then ($u.server | ok) else "?" end)]
  | join(" ") end'

# ask ends a turn that waits on tool calls ($turn). A call it already holds a
# line for keeps its code; a call evaluated "ask" gets a new one; anything else
# (a custom tool, a call it did not see, an odd id) cannot be answered from
# sock, so the turn ends with the fixed text and the owner answers in the
# console. Lines of this session for calls it no longer waits on are dropped.
ask() {
	blk=$(jq -r "$blockers_jq" "$turn" 2>/dev/null) || blk=
	fixed=
	[ -n "$blk" ] || fixed=1
	: >"$cfadd"
	{ awk -v s="$session" '"" $3 != "" s' "$confirm_file" 2>/dev/null || true; } >"$cfnew"
	added=0
	while read -r id kind name server; do
		[ -n "$id" ] || continue
		line=$(awk -v s="$session" -v t="$id" '"" $3 == "" s && "" $4 == "" t' "$confirm_file" 2>/dev/null | head -n 1)
		if [ -n "$line" ]; then
			printf '%s\n' "$line" >>"$cfnew"
			continue
		fi
		if [ "$kind" != ask ]; then
			fixed=1
			continue
		fi
		new_code
		printf '%s %s %s %s pending - %s %s\n' "$ccode" "$stdin_conv" "$session" "$id" "$name" "$server" >>"$cfadd"
		added=$((added + 1))
	done <<EOF
$blk
EOF
	if [ -n "$fixed" ]; then
		confirm_put "$cfnew"
		answer "the agent is waiting for approval of a tool call" "waiting for approval"
	fi
	# The bound, 50 lines. A sent line and a call of this turn are never
	# evicted; other pending lines go oldest first, and calls past the bound
	# are not asked: the owner answers those in the console.
	held=$(awk -v s="$session" '$5 == "sent" || "" $3 == "" s' "$cfnew" | wc -l | tr -d ' ')
	others=$(($(wc -l <"$cfnew" | tr -d ' ') - held))
	room=$((50 - held))
	[ "$room" -ge 0 ] || room=0
	skipped=0
	if [ "$added" -gt "$room" ]; then
		skipped=$((added - room))
		added=$room
	fi
	drop=$((others - (room - added)))
	[ "$drop" -ge 0 ] || drop=0
	if ! {
		awk -v s="$session" -v d="$drop" '$5 == "sent" || "" $3 == "" s { print; next } ++n > d' "$cfnew" &&
			awk -v a="$added" 'NR <= a' "$cfadd"
	} >"$cfall" 2>/dev/null; then
		log_line "confirm not writable"
		exit 1
	fi
	confirm_put "$cfall"
	if [ -n "$tuid" ] && [ "$added" -eq 0 ] && [ "$skipped" -eq 0 ]; then
		answer "recorded; $(printf '%s\n' "$blk" | grep -c .) more waiting" "approval recorded"
	fi
	# the requests are a message of their own, ahead of the agent's text: no
	# cut of that text can drop them, and they cannot be taken for it
	msg=$(requests)
	if [ "$skipped" -gt 0 ]; then
		if [ "$skipped" -eq 1 ]; then note="1 more tool call waits"; else note="$skipped more tool calls wait"; fi
		note="$note for approval: answer them in the Managed Agents console"
		if [ -n "$msg" ]; then msg="$msg

$note"; else msg=$note; fi
	fi
	if [ -n "$(printf '%s' "$1" | tr -d ' \t\r\n')" ]; then
		answer "$1" "approval requested" "$msg"
	fi
	answer "$msg" "approval requested"
}

# parse_reply sets verb (approve or deny, else empty) and ccode from the owner's
# text: trimmed, "approve <code>" as the whole message, or "deny <code>" alone
# or followed by whitespace and a reason, which goes to $reasonf. Only the verb
# is case-insensitive, and only in ASCII.
parse_reply() {
	verb=
	ccode=
	: >"$reasonf" || exit 1
	# shellcheck disable=SC2016 # jq's variables
	cmd=$(printf '%s' "$input" | jq -r '
		.text | sub("\\A[ \t\r\n]+"; "") | sub("[ \t\r\n]+\\z"; "")
		| if (.[0:8] | ascii_downcase) == "approve " and (.[8:] | test("\\A[a-km-z2-9]{6}\\z")) then "approve " + .[8:]
		  elif (.[0:5] | ascii_downcase) == "deny " and (.[5:] | test("\\A[a-km-z2-9]{6}(\\z|[ \t\r\n])")) then "deny " + .[5:11]
		  else "" end' 2>/dev/null) || cmd=
	case $cmd in
	'approve '* | 'deny '*) ;;
	*) return 0 ;;
	esac
	verb=${cmd%% *}
	ccode=${cmd#* }
	if [ "$verb" = deny ]; then
		printf '%s' "$input" | jq -j '.text | sub("\\A[ \t\r\n]+"; "") | .[11:] | sub("\\A[ \t\r\n]+"; "")' >"$reasonf" 2>/dev/null || : >"$reasonf"
	fi
}

# confirm_line sets the fields of this conversation's line for the code, or
# answers that none is pending. A line marked sent counts only for the message
# that sent it.
confirm_line() {
	line=$(BRIDGE_CODE=$ccode awk -v v="$stdin_conv" 'BEGIN { c = ENVIRON["BRIDGE_CODE"] } "" $1 == "" c && "" $2 == "" v' "$confirm_file" 2>/dev/null | head -n 1)
	# split by the shell, not a here-document (which can be a temp file)
	set -f
	# shellcheck disable=SC2086 # split into its fields on purpose
	set -- $line
	set +f
	c_session=${3:-} c_tuid=${4:-} c_state=${5:-} c_msg=${6:-}
	if [ -n "$line" ] && session_ok "${c_session:-}" && matches "${c_tuid:-}" '[A-Za-z0-9_-]{1,128}' &&
		{ [ "$c_state" = pending ] || { [ "$c_state" = sent ] && [ "$c_msg" = "$stdin_id" ]; }; }; then
		return 0
	fi
	answer "no approval is pending with that code" "approval not pending"
}

# confirm_body writes the confirmation to $body: the reason, if any, cleaned of
# control and format characters, every code in confirm.pending replaced by
# [code] in any case, cut to 1000 bytes on a character boundary
confirm_body() {
	if [ "$verb" = deny ]; then
		# format characters (Cf, U+200B among them) go before the codes are
		# looked for, so none can hide a code
		clean_text <"$reasonf" | BRIDGE_CODES=$(pending_codes) jq -Rjs "$scrub_jq"'gsub("\\p{Cf}"; "") | scrub' >"$cfadd" || exit 1
		LC_ALL=C awk -v max=1000 "$awk_cut"'
			BEGIN { ord_init() } { buf = buf (NR > 1 ? "\n" : "") $0 } END { printf "%s", substr(buf, 1, cut_at(buf, max)) }' "$cfadd" >"$reasonf" || exit 1
	fi
	# shellcheck disable=SC2016 # jq's variables
	jq -n --arg t "$c_tuid" --arg r "$verb" --rawfile m "$reasonf" '
		($m | sub("[ \t\r\n]+\\z"; "")) as $m
		| {events: [{type: "user.tool_confirmation", tool_use_id: $t, result: (if $r == "approve" then "allow" else "deny" end)}
			+ (if $r == "deny" and $m != "" then {deny_message: $m} else {} end)]}' >"$body" || exit 1
}

# confirm answers the call the owner's code names, then follows the turn it
# resumes
confirm() {
	if [ "$c_session" != "$session" ]; then
		confirm_drop_line
		answer "that approval is no longer pending" "approval refused"
	fi
	tuid=$c_tuid
	# the history tells a confirmation this message already sent (a crash
	# after the POST: follow it, post nothing again) from one answered
	# elsewhere, in the console
	catch_up
	if [ "$found" = true ]; then
		[ "$c_state" = sent ] && from_history wait
		confirm_drop_line
		answer "that approval is no longer pending" "approval refused"
	fi
	open_stream
	confirm_body
	# marked sent before the POST, as sent.ids is: a confirmation that may
	# have landed is looked up in the history before it is posted again
	# shellcheck disable=SC2016 # awk's fields
	confirm_keep '"" $1 == "" c && "" $2 == "" v { $5 = "sent"; $6 = m } { print }'
	pass=400
	if ! api POST "$base?beta=true" "$body"; then
		# not pending at the API: answered in the console, or the session
		# moved on
		pass=
		confirm_drop_line
		answer "that approval is no longer pending" "approval refused"
	fi
	pass=
	follow_stream
}

# hold_if_waiting: an ordinary reply while the session waits on a call the
# owner was asked about is not sent into the session; the owner is reminded of
# the codes. The history says what the session still waits on: lines for calls
# it no longer waits on (answered in the console, or moved past) are dropped,
# and with none left the reply goes in.
hold_if_waiting() {
	[ -f "$confirm_file" ] && awk -v s="$session" '"" $3 == "" s { f = 1 } END { exit !f }' "$confirm_file" 2>/dev/null || return 0
	fetch_history
	# shellcheck disable=SC2016 # jq's variables
	jq -r '
		[.data[]? | objects] as $d
		| ([$d | to_entries[] | select(.value.type | . == "session.status_idle" or . == "session.status_running" or . == "session.status_rescheduled" or . == "session.status_terminated")] | last) as $l
		| if $l == null or $l.value.type != "session.status_idle" or (($l.value.stop_reason | objects | .type) != "requires_action") then empty
		  else [$d[$l.key + 1:][] | select(.type == "user.tool_confirmation") | .tool_use_id | strings] as $done
		  | $l.value.stop_reason.event_ids | arrays | .[] | strings | . as $i | select($done | any(. == $i) | not)
		  end' "$hist" >"$cfadd" 2>/dev/null || : >"$cfadd"
	awk -v s="$session" -v wf="$cfadd" 'FILENAME == wf { w[$0] = 1; next } "" $3 != "" s || ($4 in w)' "$cfadd" "$confirm_file" >"$cfnew" 2>/dev/null || {
		log_line "confirm not writable"
		exit 1
	}
	confirm_put "$cfnew"
	awk -v s="$session" '"" $3 == "" s { f = 1 } END { exit !f }' "$confirm_file" 2>/dev/null || return 0
	msg=$(requests)
	if [ -n "$msg" ]; then
		answer "a tool call is waiting, so this reply was not sent to the agent:

$msg" "approval pending"
	fi
	answer "a tool call is waiting for an answer in another conversation or the console, so this reply was not sent to the agent" "approval pending"
}

# --- the turn: the stream, opened before anything is posted, then followed ---
# open_stream opens the event stream and waits for its status line: a stream
# shows only events after it opens
open_stream() {
	attempt=0
	while :; do
		left=$((deadline - $(now)))
		if [ "$left" -le 0 ]; then
			log_line "timeout"
			exit 1
		fi
		: >"$stream_file"
		: >"$stream_hdr"
		curl -q -sS --proto "$proto" --proto-redir "$proto" --max-redirs 0 -N --config "$cfg" -H 'accept: text/event-stream' -o "$stream_file" -D "$stream_hdr" \
			--connect-timeout 10 --max-time "$left" "$base/stream?beta=true" >/dev/null 2>&1 &
		stream_pid=$!
		for _ in $(seq 100); do
			grep -q '^HTTP/' "$stream_hdr" 2>/dev/null && break
			kill -0 "$stream_pid" 2>/dev/null || break
			nap 0.1
		done
		status=$(sed -n 's/^HTTP\/[0-9.]* \([0-9]*\).*/\1/p' "$stream_hdr" 2>/dev/null | tail -n 1)
		case ${status:-} in
		2??) return 0 ;;
		esac
		kill "$stream_pid" 2>/dev/null
		wait "$stream_pid" 2>/dev/null
		stream_pid=
		retry_or_exit GET "${status:-000}" "$stream_hdr"
	done
}

# follow_stream follows the stream to the end of the turn and finishes. Only
# whole lines count: curl appends as bytes arrive, and a line cut in the middle
# is read again once its newline is there. The turn's state is turn_jq's,
# carried from poll to poll in $turn. It starts at this run's anchor: the
# stream opened before the post, so what comes before that (a turn still
# running, its answer and its idle) is not this one's.
follow_stream() {
	printf '%s\n' '{"started": false}' >"$turn"
	off=0
	reason=
	while [ -z "$reason" ]; do
		if [ "$(now)" -ge "$deadline" ]; then
			log_line "timeout"
			exit 1
		fi
		size=$(wc -c <"$stream_file" | tr -d ' ')
		if [ "$size" -gt "$max_stream" ]; then
			log_line "stream too large"
			exit 1
		fi
		if [ "$size" -gt "$off" ]; then
			tail -c "+$((off + 1))" "$stream_file" >"$new"
			# drop a trailing line that has no newline yet
			if [ "$(tail -c 1 "$new" | wc -l | tr -d ' ')" != 1 ]; then sed '$d' "$new" >"$newc" && mv "$newc" "$new"; fi
			used=$(wc -c <"$new" | tr -d ' ')
			if [ "$used" -gt 0 ]; then
				off=$((off + used))
				grep '^data:' "$new" | sed 's/^data: *//' >"$batch"
				jq -Rcs --arg tag "$tag" --arg tuid "$tuid" --slurpfile st "$turn" "$turn_jq"'
					reduce (split("\n")[] | select(length > 0) | fromjson? | objects) as $e ($st[0]; step($e; $tag; $tuid))' "$batch" >"$turnn" 2>/dev/null &&
					mv "$turnn" "$turn"
				reason=$(jq -r '.reason // empty' "$turn" 2>/dev/null)
				[ -n "$reason" ] && break
				# an end before this run's own anchor showed: a stream that does
				# not echo it, or one that played another turn's end first. Nothing
				# from it is posted: the history holds the anchor and places the turn.
				if [ "$(jq -r '.unanchored // false' "$turn" 2>/dev/null)" = true ]; then
					kill "$stream_pid" 2>/dev/null
					stream_pid=
					log_line "stream unanchored"
					from_history wait
				fi
			fi
		fi
		if ! kill -0 "$stream_pid" 2>/dev/null; then
			# the stream is over: it may have ended after $size was read, so
			# measure again and read what is left once more, then give up
			size=$(wc -c <"$stream_file" | tr -d ' ')
			[ "$size" -gt "$off" ] && [ "$(tail -c 1 "$stream_file" | wc -l | tr -d ' ')" = 1 ] && continue
			log_line "stream dropped"
			exit 1
		fi
		nap 0.2
	done
	finish "$reason" "$(jq -r '(.texts // []) | join("\n\n")' "$turn")"
}

# --- the run -----------------------------------------------------------------
# an owner reply that answers a confirmation is looked up before the session:
# a code no line holds for this conversation is answered at once
parse_reply
[ -z "$verb" ] || confirm_line

[ -z "$agent" ] || resolve_session
base="$api/v1/sessions/$session/events"

[ -z "$verb" ] || confirm

# a redelivery of a message whose user.message already went in: not there at
# all, the post never landed, so it goes out below. There, but the agent is
# still working: wait for it
if [ -f "$sent_file" ] && grep -qxF "$stdin_id" "$sent_file" 2>/dev/null; then
	from_history send
else
	hold_if_waiting
fi

# a fresh turn: stream first, then send, then follow the stream. A pending
# code quoted in the reply, from any conversation, does not go into a session.
if [ -s "$confirm_file" ]; then
	input=$(printf '%s' "$input" | BRIDGE_CODES=$(pending_codes) jq -c "$scrub_jq"'.text |= scrub') || exit 1
fi
write_prompt
open_stream
jq -n --rawfile t "$prompt" '{events: [{type: "user.message", content: [{type: "text", text: $t}]}]}' >"$body"
mark_sent || {
	log_line "ledger not writable"
	exit 1
}
api POST "$base?beta=true" "$body"
follow_stream
