{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/claude-code/hooks/notify.sh\" --permission",
            "async": true,
            "statusMessage": "sock: tell your human a permission is waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/claude-code/hooks/notify.sh\" --stop --ask-now",
            "async": true,
            "statusMessage": "sock: send your human this turn's ask"
          }
        ]
      }
    ]
  }
}
