    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/sock-integrations/claude-code/hooks/notify.sh --permission",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/sock-integrations/claude-code/hooks/notify.sh --stop --ask-now",
            "async": true
          }
        ]
      }
    ]
  }
}
